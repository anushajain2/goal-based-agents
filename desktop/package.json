{
  "name": "autopilot-helper",
  "productName": "Oton Helper",
  "version": "0.1.0",
  "description": "Lets your Oton AI employees use websites in a separate Chrome window on this computer.",
  "main": "src/main.js",
  "private": true,
  "license": "UNLICENSED",
  "author": "Oton",
  "scripts": {
    "start": "electron .",
    "helper": "node src/cli.js",
    "test": "node --test --test-timeout=20000 test/*.test.js",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "ws": "8.18.3"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.0.20"
  },
  "build": {
    "appId": "com.autopilot.helper",
    "productName": "Oton Helper",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "protocols": [
      {
        "name": "Oton",
        "schemes": [
          "autopilot"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "extendInfo": {
        "LSUIElement": false
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "assets/icon.png"
    },
    "artifactName": "Oton-Helper-${version}-${os}-${arch}.${ext}",
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anushajain2/goal-based-agents.git",
    "directory": "desktop"
  }
}
