# Copy to .env (scripts/dev.sh does this for you) and fill in.

# Required for the agent to run: your Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: app connectors for 1,000+ apps (X, LinkedIn, Gmail, Slack, HubSpot, Shopify...).
# Without it, the agent does everything through Oton Chrome. https://platform.composio.dev
COMPOSIO_API_KEY=

# Optional: "Sign in with GitHub" to connect a repository. Create an OAuth app at
# github.com/settings/developers with the callback URL <your app URL>/api/integrations/github/callback
# (locally: http://localhost:3000/api/integrations/github/callback). Without it, people paste a token.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Everything below is optional --------------------------------------------------------

# Sign-in with Google (optional). In Google Cloud Console: APIs & Services > Credentials >
# Create OAuth client ID > Web application. Add this authorised redirect URI:
#   http://localhost:3000/api/auth/google/callback   (use your real address when hosted)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Emailing sign-in codes (optional). Without this, codes are printed in the terminal where
# Oton runs, which is fine on your own laptop. Any SMTP service works (Gmail with an
# app password, Resend, Postmark, Amazon SES...).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=Oton <you@gmail.com>

# WhatsApp (optional): approvals, heads-ups and questions on people's phones, through the
# platform's own WhatsApp Business number on Meta's Cloud API. Step by step: docs/WHATSAPP.md
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_NUMBER=+14155550100
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=any-long-random-string
# WHATSAPP_WABA_ID=

# The address people open in the browser (used for the Google redirect).
# FRONTEND_ORIGIN=http://localhost:3000

# Database: a local file (data/autopilot.db) by default. To scale to many workers or host it,
# use Postgres instead:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/autopilot

# Hosted for others (see docs/DEPLOY.md): ENVIRONMENT=production requires SECRET_KEY, Postgres and an
# https FRONTEND_ORIGIN, and turns Oton Chrome off (AGENT_CHROME=true turns it back on).
# ENVIRONMENT=development
# SECRET_KEY=
# AGENT_CHROME=
# SENTRY_DSN=

# Oton Chrome: auto-detected; set this if Chrome is somewhere unusual.
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Models for each job (defaults shown). The planner thinks about strategy once per work
# session; the worker does the steps (most of the cost); the checker reviews each outgoing
# action against your guardrails.
# PLANNER_MODEL=claude-opus-5-5
# PLANNER_EFFORT=medium
# WORKER_MODEL=claude-sonnet-5-5
# WORKER_EFFORT=medium
# CHECKER_MODEL=claude-haiku-5-5
# CHECKER_EFFORT=low
# Per task (names in backend/app/agent/llm.py TASKS): a slot (planner / worker / checker) or a
# model ID, and an effort. Everything not listed uses its default slot. By default goal plans
# ("How it will do it") are written by Gemini 4 Neon when GEMINI_API_KEY is set (a paid-tier key),
# else by Claude. Setting TASK_MODELS replaces that default, so include goal_plan to keep it.
# TASK_MODELS={"goal_plan": "gemini-4-neon", "session_strategist": "worker"}
# TASK_EFFORTS={"goal_steps": "low"}
# Who runs this Oton (comma-separated emails): they see AI cost by task at /ops/costs.
# OPERATOR_EMAILS=you@example.com
# MAX_MODEL_CALLS_PER_CYCLE=60

# Typical Claude cost of one work session (USD), used to suggest budgets until your
# organization has its own history.
# EST_SESSION_COST_USD=0.30

# MCP servers on this computer or your network are allowed. Set to false when hosting
# Oton for other people.
# ALLOW_PRIVATE_MCP=true

# --- Market checks at setup (optional; the platform's own keys, customers never enter them) ---
# Real Google rankings by country, AI Overviews, Maps, Google Play and ads: https://serpapi.com
SERPAPI_KEY=
# Search volume and keyword difficulty: https://dataforseo.com
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# PageSpeed Insights and YouTube (Google Cloud API key with both APIs enabled)
GOOGLE_API_KEY=
# Domain authority: https://www.domcop.com/openpagerank
OPENPAGERANK_KEY=
# Facebook/Instagram ads (Meta Ad Library API access token)
META_AD_LIBRARY_TOKEN=
# What other AI assistants recommend
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
