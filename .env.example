# Copy to .env and fill in.

# Required: the agent runs on Claude. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: app connectors for 1,000+ apps (X, LinkedIn, Gmail, Slack, HubSpot, Shopify...).
# Without it, the agent does everything through Agent Chrome. https://platform.composio.dev
COMPOSIO_API_KEY=

# Postgres (docker-compose.yml runs it on port 5433)
DATABASE_URL=postgresql+asyncpg://autopilot:autopilot@localhost:5433/autopilot

# Agent Chrome: auto-detected; set this if Chrome is somewhere unusual.
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CHROME_DEBUG_PORT=9333

# Model & effort (defaults shown)
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=high
# CHECKER_EFFORT=low
# MAX_MODEL_CALLS_PER_CYCLE=60

# Frontend -> backend URL (frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
