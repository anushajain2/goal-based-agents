# Oton video worker: the backend plus the launch-video renderer (video/: Node, Remotion, Chrome).
# Built from the repository root (it needs backend/ and video/):
#   docker build -f backend/Dockerfile.video -t autopilot-video .
#   docker run -e DATABASE_URL=... -e ANTHROPIC_API_KEY=... autopilot-video
# It runs `python -m app.worker` with WORKER_JOBS=video: it only makes launch videos.
FROM python:3.12-slim AS build
RUN pip install --no-cache-dir "uv==0.11.*"
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app/backend
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY backend/ ./
RUN uv sync --frozen --no-dev

# The renderer's packages (Remotion ships its own ffmpeg; no system ffmpeg needed).
FROM node:22-bookworm-slim AS video
WORKDIR /app/video
COPY video/package.json video/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY video/ ./

FROM python:3.12-slim
COPY --from=video /usr/local/bin/node /usr/local/bin/node
COPY --from=build /app/backend /app/backend
COPY --from=video /app/video /app/video
ENV PATH="/app/backend/.venv/bin:$PATH" PYTHONUNBUFFERED=1 PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
# Chrome for looking at sites (Playwright) and its headless shell for rendering frames, with the
# system libraries and fonts they need.
RUN playwright install --with-deps chromium chromium-headless-shell \
    && ln -s "$(ls -d /ms-playwright/chromium_headless_shell-*/chrome-headless-shell-linux64/chrome-headless-shell | head -1)" \
       /usr/local/bin/chrome-headless-shell \
    && apt-get update && apt-get install -y --no-install-recommends fonts-noto-color-emoji && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 autopilot && chmod -R a+rX /ms-playwright
ENV VIDEO_DIR=/app/video VIDEO_CHROME_PATH=/usr/local/bin/chrome-headless-shell DATA_DIR=/tmp/autopilot \
    ENVIRONMENT=production WORKER_JOBS=video VIDEOS=true
WORKDIR /app/backend
USER autopilot
CMD ["python", "-m", "app.worker"]
